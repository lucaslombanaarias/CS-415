.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.opendb
*.VC.db
*.VC.opendb
*.xcodeproj/
*.xcworkspace/

# ---- OS cruft ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---- Unreal per-user editor state ----
